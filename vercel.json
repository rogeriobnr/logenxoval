{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "buildCommand": "npm run build:cloud",
  "outputDirectory": "apps/pwa/dist",
  "functions": {
    "api/index.ts": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    { "source": "/auth/:path*", "destination": "/api" },
    { "source": "/users/:path*", "destination": "/api" },
    { "source": "/deposits/:path*", "destination": "/api" },
    { "source": "/documents/:path*", "destination": "/api" },
    { "source": "/sync", "destination": "/api" },
    { "source": "/health", "destination": "/api" }
  ]
}