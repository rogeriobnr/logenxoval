{
  "name": "@logenxoval/contracts",
  "version": "0.0.0",
  "private": true,
  "description": "Tipos e esquemas Zod compartilhados entre PWA e API",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
